<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <import type="android.view.View" />

        <import type="pub.carzy.auto_script.activities.ext.children.CommandTerminalActivity.CommandLogEntity" />
        <variable
            name="position"
            type="Integer" />
        <variable
            name="item"
            type="CommandLogEntity" />
        <variable
            name="model"
            type="pub.carzy.auto_script.entity.CommandTerminalModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="@{model.showLineNumber?View.VISIBLE:View.GONE}" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView
                android:text="@{position+`: `}"
                android:visibility="@{model.showLineNumber?View.VISIBLE:View.GONE}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <!-- 命令 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:longClickable="true"
                android:textIsSelectable="true"
                android:text="@{item.text}"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="@{item.role==CommandLogEntity.COMMAND ? View.VISIBLE : View.GONE}" />
            <!--结果-->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@{item.text}"
                android:textSize="14sp"
                android:visibility="@{item.role==CommandLogEntity.RESULT ? View.VISIBLE : View.GONE}" />
        </LinearLayout>
    </LinearLayout>
</layout>